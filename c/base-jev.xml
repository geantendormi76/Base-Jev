def sha256_file(path: Path) -> str:
    if not path.is_file():
        return ""
    h = hashlib.sha256()
    with path.open("rb") as f:
        while chunk := f.read(1024 * 1024):
            h.update(chunk)
    return h.hexdigest()
def sha256_str(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()
def load_json(path: Path) -> Any:
    if not path.is_file():
        return None
    try:
        with path.open("r", encoding="utf-8-sig") as f:
            return json.load(f)
    except Exception:
        return None
def read_jsonl(path: Path) -> List[Dict[str, Any]]:
    if not path.is_file():
        return []
    rows = []
    with path.open("r", encoding="utf-8-sig", errors="replace") as f:
        for line in f:
            line_str = line.strip()
            if line_str:
                try:
                    rows.append(json.loads(line_str))
                except Exception:
                    pass
    return rows
def compute_surface_id_comparator(method: str, path: str) -> str:
    from urllib.parse import urlparse
    parsed = urlparse(path)
    if parsed.scheme and parsed.hostname:
        host = parsed.hostname.lower()
        norm_path = parsed.path or "/"
    else:
        host = "<unknown-host>"
        norm_path = path or "/"
    if parsed.scheme and parsed.hostname and parsed.query:
        norm_path = f"{norm_path}?{parsed.query}"
    payload = "\x1f".join([method.upper(), host, norm_path]).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()[:24]
