import argparse
import asyncio
import json
import random
import sys
import time
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple
def load_excluded_surfaces(file_path_str: Optional[str]) -> Set[str]:
    excluded = set()
