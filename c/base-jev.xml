        return excluded
    p = Path(file_path_str)
    if not p.is_file():
        return excluded
    if p.suffix.lower() == ".json":
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
            for m in data.get("key_mappings", []):
                if "surface_id" in m:
