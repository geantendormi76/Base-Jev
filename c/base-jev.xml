    let passport = ModelPassport {
        passport_version: "v1.0.0".to_string(),
        model_uuid: format!("uuid-{}", &model_sha256[..12]),
        product_name: recipe.product_name.clone(),
        recipe_id: recipe.recipe_id.clone(),
