{
  "$schema": "https://repomix.com/schemas/latest/schema.json",

  // ============================================================
  // Invar AI 跨会话工程交接配置 v2.1 (Tree-sitter 骨架分层压缩版)
  //
  // 核心策略：
  //   1. 核心业务源码 (harness/agent/Rust) + 规范：保留完整实现 (Full Content)
  //   2. 庞大测试套件 (tests/) + 历史数据脚本：Tree-sitter 提取签名骨架 (compress: true)
  //   3. 极大降低交接文件体积 (从 681 KB 削减至 200 KB 左右)，Token 节省 ~70%
  // ============================================================

  "input": {
    "maxFileSize": 2000000
  },

  "output": {
    "filePath": "tmp/repomix/project-handoff.xml",
    "filePathStyle": "target-relative",
    "style": "xml",
    "compress": false,

    // ==========================================================
    // 逐文件分层过滤规则 (第一条匹配生效，精确调控骨架 vs 全文)
    // ==========================================================
    "patterns": [
      // 1. 庞大测试套件：只提取函数名、类名与签名骨架，剔除内部测试实现细节
      { "pattern": "python/tests/**/*", "compress": true },
      { "pattern": "crates/**/tests/**/*", "compress": true },

      // 2. 历史数据脚本与辅助工具：仅保留类与函数骨架
      { "pattern": "scripts/**/*", "compress": true },
      { "pattern": "python/scripts/*.py", "compress": true },

      // 3. 核心生产源码与架构文档：不压缩，保持 100% 完整实现 (未标 compress 即为全文)
      { "pattern": "python/packages/core/src/**/*" },
      { "pattern": "crates/**/src/**/*" },
      { "pattern": "HANDOFF.md" },
      { "pattern": "docs/ai/*.md" }
    ],

    "headerText": "本文件是 Invar 跨会话工程交接包 (分层骨架优化版)。核心源码与规范保留完整实现；测试用例与历史脚本采用 Tree-sitter 提取签名骨架以大幅节省 Token。未收录文件通过目录树索引。实际修改前以仓库当前源码与测试为准。",

    "fileSummary": true,
    "directoryStructure": true,
    "includeFullDirectoryStructure": true,
    "includeEmptyDirectories": false,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "truncateBase64": true,

    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 30,
      "includeDiffs": false,
      "includeLogs": false
    }
  },

  "include": [
    "HANDOFF.md",
    "README.md",
    "pytest.ini",
    "Cargo.toml",
    "package.json",
    "pnpm-workspace.yaml",
    "rust-toolchain.toml",

    // Rust 引擎
    "crates/**/Cargo.toml",
    "crates/**/src/**/*",
    "crates/**/tests/**/*",

    // Python 核心服务
    "python/pyproject.toml",
    "python/.python-version",
    "python/packages/**/pyproject.toml",
    "python/packages/**/src/**/*",

    // Python 测试 (自动匹配)
    "python/tests/test_*.py",

    // 数据流水线与活跃调度工具
    "scripts/**/*.py",
    "python/scripts/*.py",

    // 配置与规格
    "configs/**/*",
    "docs/ai/*.md"
  ],

  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "tmp/repomix/**",
      "**/repomix-output*.xml",
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx",
      "**/secrets/**",
      "**/*credentials*/**",
      "models/**/*.onnx",
      "models/**/*.gguf",
      "models/**/*.safetensors",
      "models/**/*.bin",
      "models/**/*.pt",
      "models/**/*.pth",
      "models/**/*.ckpt",
      "models/**/*.msgpack",
      "models/checkpoints/**",
      "models/cache/**",
      "data/raw/**",
      "data/interim/**",
      "data/processed/**",
      "data/**/*.csv",
      "data/**/*.parquet",
      "data/**/*.arrow",
      "data/**/*.jsonl",
      "data/**/*.sqlite",
      "data/**/*.db",
      "data/**/*.xlsx",
      "runs/**/outputs/**",
      "runs/**/artifacts/**",
      "runs/**/checkpoints/**",
      "runs/**/*.log",
      "artifacts/packages/**",
      "artifacts/exports/**",
      "artifacts/**/*.zip",
      "artifacts/**/*.tar.gz",
      "**/node_modules/**",
      "**/dist/**",
      "**/dist-ssr/**",
      "**/build/**",
      "**/target/**",
      "**/.venv/**",
      "**/.uv/**",
      "**/.uv_cache/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.pyo",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "**/.idea/**",
      "**/.vscode/**",
      "**/.DS_Store",
      "**/Thumbs.db",
      "**/*.exe",
      "**/*.dll",
      "**/*.so",
      "**/*.dylib",
      "**/*.lib",
      "**/*.a",
      "**/*.wasm",
      "**/*.pdb",
      "**/Cargo.lock",
      "**/pnpm-lock.yaml",
      "**/package-lock.json",
      "**/yarn.lock",
      "**/bun.lockb",
      "**/uv.lock",
      "**/poetry.lock",
      "**/Pipfile.lock",
      "**/coverage/**",
      "**/.coverage",
      "**/*.tmp",
      "**/*.log"
    ]
  },

  "security": {
    "enableSecurityCheck": true
  },

  "tokenCount": {
    "encoding": "o200k_base"
  }
}
