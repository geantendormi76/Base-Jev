{
  "recipe_id": "invar-intent-0.6b-v2",
  "product_name": "Invar Intent System-1 Decision Engine v2 (Targeted Active Learning)",
  "domain": "web-security-triage",
  "backbone": {
    "model_id": "models/Qwen3-0.6B-Base",
    "hidden_size": 1024,
    "max_seq_len": 2048
  },
  "heads": {
    "choice_enabled": true,
    "choice_projection_dim": 256,
    "temperature": 0.1,
    "boolean_enabled": true,
    "score_enabled": true,
    "score_max_levels": 5
