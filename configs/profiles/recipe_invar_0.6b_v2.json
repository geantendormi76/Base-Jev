  "training": {
    "learning_rate": 0.0005,
    "epochs": 6,
    "batch_size": 4,
    "gradient_accumulation_steps": 2,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "max_grad_norm": 1.0,
    "loss_weights": {
      "soft_ce": 1.0,
      "brier": 0.5,
      "entropy": 0.25
    },
    "ambiguity_anchor_ratio": 0.15
  },
  "datasets": {
    "train_path": "data/invar/distilled_invar_train_dual_v2.jsonl",
    "eval_path": "data/invar/gold_replay_buffer_60.jsonl"
  },
  "export": {
    "precision": "FP16",
    "output_filename": "system_one_unified.onnx"
  }
}